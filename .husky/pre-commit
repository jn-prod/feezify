#!/bin/sh
# pre-commit — feezify
# Secrets : les tokens vivent UNIQUEMENT dans .env (gitignoré), jamais dans un fichier suivi.
# On commite à toute heure : la fenêtre protégée s'applique au push (.husky/pre-push).

staged_env=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^\.env($|\.)' | grep -v '^\.env\.example$' || true)
if [ -n "$staged_env" ]; then
  echo ""
  echo "⛔ secret — un fichier .env est staged ($staged_env). Interdit : seul .env.example est suivi."
  echo "Les tokens vivent uniquement dans .env (gitignoré). Voir AGENTS.md → Secrets."
  echo ""
  exit 1
fi

leaks=$(git diff --cached --diff-filter=ACM -U0 \
  | grep -E '^\+' | grep -vE '^\+\+\+' \
  | grep -iE '(client_secret|access_token|refresh_token|api_key|[a-z0-9]_token|[a-z0-9]_secret)[[:space:]]*[:=][[:space:]]*["'\'']?[A-Za-z0-9._-]{16,}' \
  | grep -ivE 'your_|xxxx|placeholder|example|changeme|redacted|<[a-z]|\{[0-9]|git[[:space:]]grep' || true)
if [ -n "$leaks" ]; then
  echo ""
  echo "⛔ secret potentiel dans le diff staged (token/secret hors .env) :"
  echo "$leaks" | head -5
  echo ""
  echo "Déplace-le dans .env (gitignoré) et retire-le du fichier. Voir AGENTS.md → Secrets."
  echo "Override conscient : git commit --no-verify"
  echo ""
  exit 1
fi

# success — never let an empty grep (set -e) fail the hook
exit 0
