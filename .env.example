# feezify — environment template.
# Copy to .env and fill in your tokens:  cp .env.example .env
#
# RULE: adapter tokens live ONLY in .env (which is git-ignored). NEVER put a real token in
# any other file — not in code, fixtures, configs, docs, the markdown core, or this example.
# Keep this file with EMPTY values only. See AGENTS.md → Secrets and init.md.

# --- Strava adapter --- (create an app: https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# --- Future adapters add their own *_TOKEN / *_SECRET / *_API_KEY here ---
