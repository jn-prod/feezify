{
  "name": "feezify",
  "version": "2.0.0-beta.2",
  "description": "A training copilot, AI-native: a skill + a portable markdown core. Zero infra.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "bin": {
    "feezify-lecture": "dist/lecture.js",
    "feezify-memory-guard": "dist/memory-guard.js"
  },
  "scripts": {
    "build": "tsup src/bin/lecture.ts src/bin/memory-guard.ts --format esm --clean",
    "build:bundle": "tsup --config tsup.bundle.config.ts",
    "package:skill": "pnpm build:bundle && node scripts/package-skill.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "fflate": "^0.8.3",
    "husky": "^9.1.7",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2"
    }
  }
}
